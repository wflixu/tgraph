registry=https://registry.npmmirror.com

# Enable hoisting to install dependencies in root node_modules
hoist=true
hoist-pattern[]=*

# Shamefully hoist all packages, including dev dependencies
shamefully-hoist=true

# Prevent certain packages from being hoisted if they cause conflicts
nohoist-pattern=@babel/core
nohoist-pattern=eslint
nohoist-pattern=typescript
nohoist-pattern=vitest
nohoist-pattern=@vitest
nohoist-pattern=@typescript-eslint
nohoist-pattern=tsdown
nohoist-pattern=typedoc

# Prefer local packages for better performance
prefer-workspace-packages=true
